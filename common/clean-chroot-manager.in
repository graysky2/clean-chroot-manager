#!/bin/bash
#
# clean-chroot-manager by graysky
#

# shellcheck disable=1090 disable=1091

set -eo pipefail

VERS='@VERSION@'
PKG='clean-chroot-manager'
SKEL="/usr/share/$PKG/ccm.skel"

### Begin insert of Arch script
# Avoid any encoding problems
export LANG=C

# check if messages are to be printed using color
unset ALL_OFF BOLD BLUE GREEN RED YELLOW
if [[ -t 2 ]]; then
  # prefer terminal safe colored and bold text when tput is supported
  if tput setaf 0 &>/dev/null; then
    ALL_OFF="$(tput sgr0)"
    BOLD="$(tput bold)"
    BLUE="${BOLD}$(tput setaf 4)"
    GREEN="${BOLD}$(tput setaf 2)"
    RED="${BOLD}$(tput setaf 1)"
    YELLOW="${BOLD}$(tput setaf 3)"
  else
    ALL_OFF=$'\e[0m'
    BOLD=$'\e[1m'
    BLUE="${BOLD}"$'\e[34m'
    GREEN="${BOLD}"$'\e[32m'
    RED="${BOLD}"$'\e[31m'
    YELLOW="${BOLD}"$'\e[33m'
  fi
fi
readonly ALL_OFF BOLD BLUE GREEN RED YELLOW

### End insert of Arch script

# internal state; never inherit it from the environment
unset CLEANIT RUNCHECK MAKEPKG_ARGS INJECT_PKGS MULTI_ROOT SLOTFILE INTERNAL_REPO TMP_PAC BUILD_MARKER LOCK_FD

msg() {
  printf '%s==>%s%s %s%s\n' "$GREEN" "$ALL_OFF" "$BOLD" "$*" "$ALL_OFF"
}

msg2() {
  printf '%s---->%s%s %s%s\n' "$YELLOW" "$ALL_OFF" "$BOLD" "$*" "$ALL_OFF"
}

error() {
  printf '%s==> ERROR:%s%s %s%s\n' "$RED" "$ALL_OFF" "$BOLD" "$*" "$ALL_OFF" >&2
}

die() {
  error "$@"
  exit 1
}

# run a command as the invoking user without going through a shell
as_user() {
  runuser -u "$USER" -- "$@"
}

if [[ -z "$SUDO_USER" ]]; then
  if logname &>/dev/null; then
    USER=$(logname)
  fi
elif [[ "$SUDO_USER" = "root" ]]; then
  die "Cannot determine your username."
else
  USER="$SUDO_USER"
fi

user_info=$(getent passwd "$USER") || die "Cannot look up user $USER."
IFS=: read -r _ _ user_uid _ _ HOMEDIR _ <<< "$user_info"
XDG_RUNTIME_DIR="/run/user/$user_uid"

# allow user to override from cli thus using multiple files as needed
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOMEDIR/.config}"
CFGFILE=${CFGFILE:-$XDG_CONFIG_HOME/$PKG.conf}

# dependency checks probably not needed but they do not hurt
if ! command -v mkarchroot >/dev/null 2>&1; then
  die "devtools is required to use this script."
fi

# everything that has to be undone on exit, however we get there
cleanup() {
  if [[ -n "$TMP_PAC" ]]; then
    rm -f "$TMP_PAC"
  fi
  if [[ -n "$BUILD_MARKER" ]]; then
    rm -f "$BUILD_MARKER"
  fi
  # the kernel drops the lock when we exit; this also releases it for any
  # child that inherited the fd
  if [[ -n "$LOCK_FD" ]]; then
    flock -u "$LOCK_FD"
  fi
  return 0
}
trap cleanup EXIT

# helper to convert raw bytes to auto-scaling IEC units
format_bytes() {
    awk '{
        split("B KiB MiB GiB TiB PiB", u);
        n=$1; i=1; while(n>=1024 && i<6) { n/=1024; i++ }
        printf "%.2f %s", n, u[i]
    }'
}

dir_size() {
  diskus "$1" 2>/dev/null | format_bytes
}

dir_empty() {
  [[ -z $(find "$1" -mindepth 1 -print -quit 2>/dev/null) ]]
}

check_config() {
  [[ $EUID -eq 0 ]] || die "This script must be called as root."
  [[ -f $SKEL ]] || die "$SKEL is missing. Reinstall this package to continue."

  if [[ ! -f "$CFGFILE" ]]; then
    echo -e "${BOLD}------------------------------------------------------------${ALL_OFF}"
    echo -e "${BOLD} No config file found so creating a fresh one in:${ALL_OFF}"
    echo -e "${BOLD}${BLUE} $CFGFILE${ALL_OFF}"
    echo
    echo -e "${BOLD} Edit this file before invoking $PKG again.${ALL_OFF}"
    echo -e "${BOLD}------------------------------------------------------------${ALL_OFF}"
    as_user install -Dm644 "$SKEL" "$CFGFILE"
    as_user sed -i "/^THREADS=/ s,9,$(( $(nproc --all) + 1 ))," "$CFGFILE"
    exit 0
  fi

  . "$CFGFILE"

  # parse config file for correctness
  [[ -d "$CHROOTPATH" ]] || mkdir -p "$CHROOTPATH" ||
    die "Invalid CHROOTPATH defined in $CFGFILE"

  [[ "$THREADS" =~ ^[0-9]+$ ]] ||
    die "Invalid setting for THREADS defined in $CFGFILE"

  if [[ -n "$DISTCC_THREADS" ]] && ! [[ "$DISTCC_THREADS" =~ ^[0-9]+$ ]]; then
    die "Invalid setting for DISTCC_THREADS defined in $CFGFILE"
  fi

  # make sure we have a dir with correct permissions for ccache to use
  if [[ -n ${CCACHE_DIR+x} ]]; then
    [[ -d "$CCACHE_DIR" ]] || die "Invalid CCACHE_DIR defined in $CFGFILE"
    as_user test -w "$CCACHE_DIR" ||
      die "User $USER has no write permissions on $CCACHE_DIR"
  fi

  if [[ -n "$REPO" ]]; then
    # external repo; if user defined a trailing slash remove it here
    # note that we still have to modify pacman.conf to add a line for the repo
    # but only after it is populated with packages which is in the indexit function
    REPO="${REPO%/}"
    [[ -d "$REPO" ]] || mkdir "$REPO"
    as_user test -w "$REPO" ||
      die "User $USER has no write permissions on $REPO"
  else
    # internal repo lives inside each slot's chroot so use_slot sets it
    INTERNAL_REPO=1
  fi

  REPO_NAME="${REPO_NAME:-chroot_local}"

  BUILDLOG="${BUILDLOG:-$HOMEDIR/ccm-build.log}"
  if [[ ! -f "$BUILDLOG" ]]; then
    printf 'Date\tPackage\tTime\n' | as_user tee "$BUILDLOG" >/dev/null ||
      die "User $USER has no write permissions to BUILDLOG $BUILDLOG"
  fi
  as_user test -w "$BUILDLOG" ||
    die "User $USER has no write permissions to BUILDLOG $BUILDLOG"

  # without MAX_ROOTS there is a single slot and no slot file
  if [[ -n "${MAX_ROOTS+x}" ]]; then
    if ! [[ "$MAX_ROOTS" =~ ^[0-9]+$ ]] || [[ "$MAX_ROOTS" -lt 1 ]]; then
      die "MAX_ROOTS must be an integer >= 1 in $CFGFILE"
    fi
    MULTI_ROOT=1
    SLOTFILE="$XDG_CONFIG_HOME/ccm.slot"
  else
    MAX_ROOTS=1
  fi

  CHROOTPATH_BASE="$CHROOTPATH"
  if [[ -n "$MULTI_ROOT" ]]; then
    reconcile_slots
  fi
  use_slot "$(active_slot)"
}

check_chroot() {
  chroot_exists ||
    die "No chroot found; create one using the 'c' option and try again."
}

chroot_exists() {
  [[ -f "$CHROOTPATH"/root/.arch-chroot ]]
}

# print the slot number stored in the slot file, falling back to 1
active_slot() {
  local slot
  if [[ -n "$SLOTFILE" ]]; then
    slot=$(cat "$SLOTFILE" 2>/dev/null || true)
  fi
  if [[ "$slot" =~ ^[0-9]+$ ]] && (( slot >= 1 )); then
    echo "$slot"
  else
    echo 1
  fi
}

set_active_slot() {
  [[ -n "$SLOTFILE" ]] || return 0
  echo "$1" | as_user tee "$SLOTFILE" >/dev/null
}

# slot 1 uses CHROOTPATH as-is; slot n becomes CHROOTPATH-n
slot_path() {
  if (( $1 == 1 )); then
    echo "$CHROOTPATH_BASE"
  else
    echo "${CHROOTPATH_BASE}-$1"
  fi
}

slot_exists() {
  [[ -f "$(slot_path "$1")/root/.arch-chroot" ]]
}

slot_lock() {
  echo "$XDG_RUNTIME_DIR/ccm-$1.lock"
}

# point CHROOTPATH, the build lock and an internal repo at slot $1
use_slot() {
  SLOT=$1
  CHROOTPATH=$(slot_path "$SLOT")
  CCM_LOCK=$(slot_lock "$SLOT")
  if [[ -n "$INTERNAL_REPO" ]]; then
    REPO="${CHROOTPATH%/}/root/repo"
  fi
}

reconcile_slots() {
  # If the active slot's chroot is missing (e.g. tmpfs cleared on reboot),
  # silently reset to the lowest-numbered existing slot or to 1 if none exist.
  local active s
  active=$(active_slot)
  slot_exists "$active" && return 0

  for (( s=1; s<=MAX_ROOTS; s++ )); do
    if slot_exists "$s"; then
      set_active_slot "$s"
      return 0
    fi
  done
  set_active_slot 1
}

next_free_slot() {
  local s
  for (( s=1; s<=MAX_ROOTS; s++ )); do
    if ! slot_exists "$s"; then
      echo "$s"
      return 0
    fi
  done
  return 1
}

check_runtime_dir() {
  [[ -d "$XDG_RUNTIME_DIR" ]] ||
    die "$XDG_RUNTIME_DIR does not exist. Is $USER logged in?"
}

acquire_repo_lock() {
  # No-op for single-root users; only needed when slots can run concurrently
  [[ -n "$MULTI_ROOT" ]] || return 0

  check_runtime_dir
  exec {REPO_LOCK_FD}>"$XDG_RUNTIME_DIR/ccm-repo.lock"
  if ! flock -w 90 "$REPO_LOCK_FD"; then
    exec {REPO_LOCK_FD}>&-
    die "Could not acquire repo index lock after 90s. Another repo operation may be stalled."
  fi
}

release_repo_lock() {
  [[ -z "${REPO_LOCK_FD+x}" ]] && return 0

  flock -u "$REPO_LOCK_FD"
  exec {REPO_LOCK_FD}>&-
  unset REPO_LOCK_FD
}

acquire_build_lock() {
  check_runtime_dir
  # open without truncating so a failed attempt keeps the holder's pid
  exec {LOCK_FD}>>"$CCM_LOCK"
  if ! flock -n "$LOCK_FD"; then
    exec {LOCK_FD}>&-
    unset LOCK_FD
    die "Active build detected. Try again when not building."
  fi
  # record who holds the lock so preview can show the build time
  echo "$$" > "$CCM_LOCK"
}

# print how long the build holding slot $1's lock has been running
build_elapsed() {
  local lock fd pid etime
  lock=$(slot_lock "$1")
  [[ -f "$lock" ]] || return 1
  exec {fd}>>"$lock"
  if flock -n "$fd"; then
    exec {fd}>&-
    return 1
  fi
  exec {fd}>&-
  pid=$(<"$lock")
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  etime=$(ps --no-headers -o etime -p "$pid") || return 1
  echo "${etime// /}"
}

# rewrite a file in place by piping it through a filter command
filter_file() {
  local file=$1 tmp
  shift
  tmp=$(mktemp "$file.XXXXXX")
  if ! "$@" < "$file" > "$tmp"; then
    rm -f "$tmp"
    die "Failed to update $file"
  fi
  chmod --reference="$file" "$tmp"
  chown --reference="$file" "$tmp"
  mv -f "$tmp" "$file"
}

# true if makepkg in the chroot at $1 would build with BUILDENV option $2;
# sources the config like makepkg does so the last entry wins
buildenv_enabled() {
  local conf="$1/etc/makepkg.conf"
  [[ -f "$conf" ]] || return 1
  (
    BUILDENV=()
    source "$conf" &>/dev/null
    for f in "$conf".d/*.conf; do
      [[ -f "$f" ]] && source "$f" &>/dev/null
    done
    for (( i=${#BUILDENV[@]}-1; i>=0; i-- )); do
      [[ "${BUILDENV[i]}" == "$2" ]] && exit 0
      [[ "${BUILDENV[i]}" == "!$2" ]] && exit 1
    done
    exit 1
  )
}

# ccm's settings for makepkg in the chroot live in a drop-in so the
# makepkg.conf from pacman, devtools or the user is never edited
write_makepkg_dropin() {
  local dir="$CHROOTPATH/root/etc/makepkg.conf.d"
  mkdir -p "$dir"
  {
    echo "# Generated by clean-chroot-manager"
    if [[ -n "$RUNDISTCC" ]]; then
      echo 'BUILDENV+=(distcc)'
      printf 'DISTCC_HOSTS=%q\n' "$DISTCC_HOSTS"
    fi
    if [[ -d "$CCACHE_DIR" ]]; then
      echo 'BUILDENV+=(ccache)'
    fi
    if [[ -n "$PKGEXT" ]]; then
      printf 'PKGEXT=%q\n' "$PKGEXT"
    fi
  } > "$dir/ccm.conf"
}

# keep the copy makechrootpkg builds in on the same pacman.conf as root
sync_pacman_conf() {
  if [[ -f "$CHROOTPATH/$USER/etc/pacman.conf" ]]; then
    cp "$CHROOTPATH/root/etc/pacman.conf" "$CHROOTPATH/$USER/etc/pacman.conf"
  fi
}

# list the local repo in the chroot's pacman.conf ahead of all other repos
add_local_repo() {
  local conf="$CHROOTPATH/root/etc/pacman.conf"
  [[ -f "$conf" ]] || return 0
  grep -qxF "[$REPO_NAME]" "$conf" && return 0

  NAME="$REPO_NAME" SERVER="file://$REPO" filter_file "$conf" awk '
    function block() {
      printf "# Added by clean-chroot-manager\n[%s]\nSigLevel = Never\nServer = %s\n\n",
        ENVIRON["NAME"], ENVIRON["SERVER"]
      done = 1
    }
    !done && /^#?\[/ && !/^#?\[options\]/ { block() }
    { print }
    END { if (!done) { print ""; block() } }'
  sync_pacman_conf
}

testing_enabled() {
  grep -qE '^\[[a-z]+-testing\][[:space:]]*$' "$1/etc/pacman.conf" 2>/dev/null
}

# comment out every [*-testing] block in pacman.conf, or uncomment the ones
# for core, extra and (if it is enabled) multilib.
# Disabling comments out every active line of a block; the header and Include
# get a plain '#' like the stock pacman.conf and anything else gets '#ccm#'.
# Enabling undoes exactly that, so lines the user commented out stay that way.
set_testing() {
  local conf="$CHROOTPATH/root/etc/pacman.conf" repos='core|extra'
  if grep -qE '^\[multilib\][[:space:]]*$' "$conf"; then
    repos+='|multilib'
  fi

  # shellcheck disable=SC2016
  ON=$1 REPOS="^#?\\[($repos)-testing\\][[:space:]]*\$" filter_file "$conf" awk '
    /^#?\[/ { sec = /^#?\[[a-z]+-testing\][[:space:]]*$/; want = $0 ~ ENVIRON["REPOS"] }
    /^[[:space:]]*$/ { sec = 0 }
    sec && ENVIRON["ON"] && want {
      if (/^#(\[|Include[[:space:]]*=)/) sub(/^#/, "")
      else sub(/^#ccm#/, "")
    }
    sec && !(ENVIRON["ON"] && want) && !/^#/ {
      if (/^(\[|Include[[:space:]]*=)/) $0 = "#" $0
      else $0 = "#ccm#" $0
    }
    { print }'
  sync_pacman_conf
}

create() {
  chroot_exists && die "Working directory $CHROOTPATH already exists."
  mkdir -p "$CHROOTPATH" || die "Failed to create $CHROOTPATH"

  local pkgs=('base-devel') mkargs=()

  if [[ -n "$RUNDISTCC" ]]; then
    pkgs+=('distcc')
  fi
  if [[ -d "$CCACHE_DIR" ]]; then
    pkgs+=('ccache')
  fi

  if [[ -f "$CUSTOM_PACMAN_CONF" ]]; then
    mkargs+=(-C "$CUSTOM_PACMAN_CONF")
  elif [[ -f /etc/pacman.conf ]]; then
    # with pacman 7.0.0 having a setting of 'DownloadUser = alpm' in /etc/pacman.conf
    # will cause the creation of the chroot to break so this is a hacky fix
    TMP_PAC=$(mktemp)
    chmod 644 "$TMP_PAC"
    sed '/DownloadUser = alpm/d' /etc/pacman.conf > "$TMP_PAC"
    mkargs+=(-C "$TMP_PAC")
  fi

  if [[ -f "$CUSTOM_MAKEPKG_CONF" ]]; then
    mkargs+=(-M "$CUSTOM_MAKEPKG_CONF")
  else
    # there can be disconnects in variables between makepkg.conf provided by the pacman
    # package and the one provided by the devtools package so in order to maintain
    # consistent behavior of scripts like extra-x86_64-build and others listed on the wiki
    # under the "Convenience way" section (link below), we use the devtools
    # makepkg-x86_64.conf rather than the one defined on the live system
    #
    # https://wiki.archlinux.org/title/DeveloperWiki:Building_in_a_clean_chroot#Convenience_way
    mkargs+=(-M /usr/share/devtools/makepkg.conf.d/x86_64.conf)
  fi

  mkarchroot "${mkargs[@]}" "$CHROOTPATH"/root "${pkgs[@]}" || exit 1

  write_makepkg_dropin

  # make the empty dir for an internal repo in root's copy of the chroot
  # note that we still have to modify pacman.conf to add a line for the repo
  # but only after it is populated with packages which is in the indexit function
  if [[ ! -d "$REPO" ]]; then
    mkdir "$REPO"
    chown "$USER" "$REPO"
  fi
  # pacman 7.0.0 requires alpm gid for local repos
  if [[ $(stat -c %G "$REPO") != alpm ]]; then
    chown -R :alpm "$REPO"
  fi
  as_user test -w "$REPO" ||
    die "User $USER has no write permissions on $REPO"

  # if we are using an external repo and if it has a db, add it to pacman.conf if not do nothing
  if [[ -z "$INTERNAL_REPO" && -f "$REPO/$REPO_NAME.db.tar.gz" ]]; then
    add_local_repo
  fi
}

# print the packages in dir $1, optionally only those newer than the file $2
find_pkgs() {
  local newer=()
  if [[ -n "$2" ]]; then
    newer=(-newer "$2")
  fi
  find "$1" -maxdepth 1 -type f -name '*.pkg.tar*' ! -name '*.sig' \
    ! -name '*namcap.log' "${newer[@]}" | sort
}

# makechrootpkg moves finished packages to PKGDEST from the user's makepkg
# config, or to the current dir if that is unset
pkgdest() {
  local dest
  # shellcheck disable=SC2016
  dest=$(as_user bash -c 'source /usr/share/makepkg/util/config.sh &&
    load_makepkg_config &>/dev/null; printf "%s" "$PKGDEST"' 2>/dev/null || true)
  if [[ -n "$dest" && -d "$dest" ]]; then
    echo "$dest"
  else
    echo "$PWD"
  fi
}

# run makechrootpkg; set BUILT_PKGS to the packages it produced
build() {
  local args=('-u') postargs=() env=() start pkg diff

  if [[ "$CLEANIT" -eq 1 ]]; then
    args+=('-c')
  fi
  if [[ -n "$RUNNAMCAP" ]]; then
    args+=('-n')
  fi
  if [[ -d "$CCACHE_DIR" ]]; then
    args+=(-d "$CCACHE_DIR:/build/.ccache")
  fi
  if [[ -d "$DISTCC_DIR" ]]; then
    args+=(-d "$DISTCC_DIR:/build/.distcc")
  fi

  for pkg in "${INJECT_PKGS[@]}"; do
    [[ -f "$pkg" ]] || die "Inject package not found: $pkg"
    [[ "$pkg" == *.pkg.tar.* ]] ||
      die "File does not appear to be a package archive: $pkg"
    args+=(-I "$pkg")
  done

  if [[ "$RUNCHECK" -eq 1 ]]; then
    # makepkg honors the last of --check/--nocheck
    postargs+=('--check')
  elif [[ "$NOCHECK" -eq 1 ]]; then
    postargs+=('--nocheck')
  fi
  postargs+=("${MAKEPKG_ARGS[@]}")

  # makechrootpkg reads MAKEFLAGS and PACKAGER from a custom makepkg.conf, so
  # only pass the values from the ccm config when the system one is in use
  if [[ ! -f "$CUSTOM_MAKEPKG_CONF" ]]; then
    env+=(PACKAGER="$PACKAGER" MAKEFLAGS="-j$THREADS")
  fi

  BUILD_MARKER=$(mktemp)
  start=$EPOCHSECONDS
  env "${env[@]}" nice -n 19 makechrootpkg "${args[@]}" -r "$CHROOTPATH" -- "${postargs[@]}" ||
    exit 1

  diff=$(( EPOCHSECONDS - start ))
  if (( diff > 86400 )); then
    printf -v BUILD_TIME '%d days, %02d:%02d:%02d' $((diff/86400)) $(((diff%86400)/3600)) $(((diff%3600)/60)) $((diff%60))
  else
    printf -v BUILD_TIME '%02d:%02d:%02d' $((diff/3600)) $(((diff%3600)/60)) $((diff%60))
  fi

  # makepkg can fail to build without throwing an error code and older
  # packages may be lying around, so only trust what this build wrote
  mapfile -t BUILT_PKGS < <(find_pkgs "$(pkgdest)" "$BUILD_MARKER")
  (( ${#BUILT_PKGS[@]} )) || die "The build did not produce any packages."
}

# sign the given packages if GPGKEY is defined
sign_pkgs() {
  [[ -n "$GPGKEY" ]] || return 0
  local pkg
  for pkg in "$@"; do
    rm -f "$pkg".sig
    as_user gpg --detach-sign --use-agent -u "$GPGKEY" --no-armor "$pkg" &>/dev/null ||
      die "Failed to sign $pkg"
  done
}

# test that the defined key can sign before doing any real work
check_gpgkey() {
  [[ -n "$GPGKEY" ]] || return 0
  local tmp ok=1
  tmp=$(as_user mktemp)
  as_user gpg --detach-sign --use-agent -u "$GPGKEY" --no-armor "$tmp" &>/dev/null || ok=0
  rm -f "$tmp" "$tmp".sig
  (( ok )) || die "Invalid GPGKEY defined."
}

# copy the given package files (and signatures) to the repo and index them
indexit() {
  local pkg files=() repo_pkgs=()
  (( $# )) || die "No packages found to add to local repo."
  [[ -d "$REPO" ]] || die "Local repo $REPO does not exist. Create the chroot first."

  msg2 "Adding packages to chroot repo..."

  # external repos with db files are already setup when we made the chroot
  # but for internal repos, if this is the first time a package has been built,
  # append the local repo to the chroot's pacman.conf
  add_local_repo

  for pkg in "$@"; do
    files+=("$pkg")
    if [[ -f "$pkg".sig ]]; then
      files+=("$pkg".sig)
    fi
    repo_pkgs+=("$REPO/${pkg##*/}")
  done

  acquire_repo_lock
  as_user cp -- "${files[@]}" "$REPO/"
  as_user repo-add "$REPO/$REPO_NAME.db.tar.gz" "${repo_pkgs[@]}"
  release_repo_lock
}

logbuild() {
  local info base ver
  info=$(bsdtar -xOf "$1" .PKGINFO) || return 0
  base=$(sed -n 's/^pkgbase = //p' <<< "$info")
  ver=$(sed -n 's/^pkgver = //p' <<< "$info")

  # Two slots can finish a build nearly simultaneously; serialise the append
  # with the repo lock so lines are never interleaved in the build log.
  acquire_repo_lock
  printf '%s\t%s\t%s\n' "$(date +%c)" "$base-$ver" "$BUILD_TIME" |
    as_user tee -a "$BUILDLOG" >/dev/null
  release_repo_lock
}

update() {
  msg2 "Updating the chroot..."
  arch-nspawn "$CHROOTPATH"/root pacman -Syu --noconfirm
}

testing() {
  grep -qE '^#?\[[a-z]+-testing\][[:space:]]*$' "$CHROOTPATH/root/etc/pacman.conf" ||
    die "No [*-testing] repos found in $CHROOTPATH/root/etc/pacman.conf"

  if testing_enabled "$CHROOTPATH/root"; then
    msg2 "Disabling [*-testing] in chroot..."
    set_testing 0
    msg2 "Downgrading affected packages if any..."
    arch-nspawn "$CHROOTPATH"/root pacman -Syuu --noconfirm
  else
    msg2 "Enabling [*-testing] in chroot..."
    set_testing 1
    msg2 "Forcing an update to use any affected packages..."
    arch-nspawn "$CHROOTPATH"/root pacman -Syu --noconfirm
  fi
}

repocheck() {
  if [[ -z $(find "$REPO" -maxdepth 1 -name '*.pkg.tar*' -print -quit 2>/dev/null) ]]; then
    die "Local repo is empty."
  fi
}

list() {
  ls --color -lhF -I "$REPO_NAME.*" "$REPO"
}

buildrepolist() {
  local db="$REPO/$REPO_NAME.db.tar.gz"
  [[ -f "$db" ]] || die "Cannot locate or read $db so quitting."

  # Build a map of DB entry key (pkgname-pkgver-pkgrel) -> pkgname straight
  # from the desc files in the DB, which avoids a call to pacman as the local
  # sync may be out-of-date. The key matches the tarfile stem after stripping
  # the trailing -arch field. This lets us cross-reference on-disk files
  # against the DB without assuming the two sets are the same size or order
  # (e.g. orphaned old versions).
  unset db_entry_to_pkgname
  declare -gA db_entry_to_pkgname=()
  local name ver
  while read -r name ver; do
    db_entry_to_pkgname["$name-$ver"]="$name"
  done < <(bsdtar -xOf "$db" '*/desc' |
    awk '/^%NAME%$/ { getline; n = $0 } /^%VERSION%$/ { getline; print n, $0 }')

  mapfile -t tarfiles < <(find "$REPO" -name '*.pkg.tar*' ! -name '*.sig' | sort)
}

deletepkgs() {
  local i user_input num idx numbers=() files_to_delete=()
  buildrepolist

  for i in "${!tarfiles[@]}"; do
    printf "%2d) %s\n" $((i+1)) "$(basename "${tarfiles[i]}")"
  done

  read -r user_input

  if [[ "$user_input" == "q" ]]; then
    exit 0
  fi

  if [[ "$user_input" == "a" ]]; then
    files_to_delete=("${tarfiles[@]}")
  else
    IFS=' ' read -ra numbers <<< "$user_input"
    for num in "${numbers[@]}"; do
      if ! [[ "$num" =~ ^[0-9]+$ ]]; then
        continue
      fi
      idx=$((num - 1))
      if (( idx < 0 || idx >= ${#tarfiles[@]} )); then
        continue
      fi
      files_to_delete+=("${tarfiles[$idx]}")
    done
  fi

  local f stem db_key pkgname
  acquire_repo_lock
  for f in "${files_to_delete[@]}"; do
    # Derive the DB key from the filename:
    #   foo-1.3-1-x86_64.pkg.tar.zst -> strip extension -> foo-1.3-1-x86_64
    #                                 -> strip trailing -arch -> foo-1.3-1
    # This matches the directory name used by repo-add inside the DB tarball.
    stem=$(basename "$f")
    stem="${stem%.pkg.tar.*}"
    db_key="${stem%-*}"

    pkgname="${db_entry_to_pkgname[$db_key]:-}"
    if [[ -n "$pkgname" ]]; then
      # Only remove from DB if this exact version is the registered entry.
      # Orphaned older versions on disk will not have a db_key hit, so their
      # pkgname resolves empty and we skip repo-remove, preserving the current
      # DB entry for the newer version.
      as_user repo-remove -q "$REPO/$REPO_NAME.db.tar.gz" "$pkgname" || true
    fi

    rm -f "$f" "$f".sig
  done
  release_repo_lock
}

nuke() {
  wipe_dir "$CHROOTPATH"

  # If a non-default slot was just nuked, silently reset to slot 1
  if [[ -n "$MULTI_ROOT" && "$SLOT" -gt 1 ]]; then
    set_active_slot 1
    msg2 "Slot $SLOT nuked. Switched back to slot 1."
  fi
}

nukeallpkgs() {
  # an internal repo was already deleted along with the chroot
  [[ -f "$REPO/$REPO_NAME.db.tar.gz" ]] || return 0
  buildrepolist

  # Empty the DB rather than deleting it so other slots that list the repo
  # in their pacman.conf can still sync.
  local -A names=()
  local pkgname f
  for pkgname in "${db_entry_to_pkgname[@]}"; do
    names["$pkgname"]=1
  done

  acquire_repo_lock
  if (( ${#names[@]} )); then
    as_user repo-remove -q "$REPO/$REPO_NAME.db.tar.gz" "${!names[@]}" || true
  fi
  for f in "${tarfiles[@]}"; do
    rm -f "$f" "$f".sig
  done
  release_repo_lock
}

# print one aligned "label: value" line of the preview, with an optional
# color for the label
row() {
  printf '%s%s %-17s%s%s%s\n' "$BOLD" "$3" "$1" "$ALL_OFF" "$2" "$ALL_OFF"
}

# print a feature name in green if enabled or red if not
flag() {
  if "${@:2}"; then
    printf '%s%s%s' "$GREEN" "$1" "$ALL_OFF"
  else
    printf '%s%s%s' "$RED" "$1" "$ALL_OFF"
  fi
}

preview() {
  local size custom_threads threads active s path label color marker root elapsed

  echo -e "${BOLD}$PKG v$VERS${ALL_OFF}"
  echo

  if [[ -n "$CCACHE_DIR" ]]; then
    if dir_empty "$CCACHE_DIR"; then
      size="${RED}(Empty cache)"
    else
      size="($(dir_size "$CCACHE_DIR"))"
    fi
    row "ccache path:" "${BLUE}$CCACHE_DIR/${ALL_OFF}${BOLD} $size"
  fi

  if [[ -f "$CUSTOM_PACMAN_CONF" ]]; then
    row "custom config:" "$CUSTOM_PACMAN_CONF"
  fi

  # honor the MAKEFLAGS in a custom config if defined ie override what is defined in the config file
  if [[ -f "$CUSTOM_MAKEPKG_CONF" ]]; then
    row "custom config:" "$CUSTOM_MAKEPKG_CONF"
    custom_threads=$(MAKEFLAGS=; source "$CUSTOM_MAKEPKG_CONF" &>/dev/null; echo "${MAKEFLAGS//[^0-9]/}")
  fi

  if dir_empty "$REPO"; then
    size="${RED}(Empty repo)"
  else
    size="($(dir_size "$REPO"))"
  fi
  echo
  row "repo path:" "${BLUE}$REPO/${ALL_OFF}${BOLD} $size"
  row "repo name:" "$REPO_NAME"

  active=$(active_slot)
  for (( s=1; s<=MAX_ROOTS; s++ )); do
    path=$(slot_path "$s")
    root="$path/root"
    color=""
    marker=""
    if [[ -n "$MULTI_ROOT" ]]; then
      label="slot $s:"
      if (( s == active )); then
        color=$GREEN
        marker="${GREEN} <- active"
      fi
    else
      label="chroot path:"
    fi

    echo
    if ! slot_exists "$s"; then
      row "$label" "${RED}(not present)${marker}" "$color"
      continue
    fi
    row "$label" "${BLUE}${path%/}/${ALL_OFF}${BOLD} ($(dir_size "$path"))${marker}" "$color"

    if [[ -n "$custom_threads" ]]; then
      threads=$custom_threads
    elif [[ -n "$DISTCC_THREADS" ]] && buildenv_enabled "$root" distcc; then
      threads=$DISTCC_THREADS
    else
      threads=$THREADS
    fi
    row "  threads:" "$threads"
    row "  options:" "$(flag '[*-testing]' testing_enabled "$root")  $(flag distcc buildenv_enabled "$root" distcc)  $(flag ccache buildenv_enabled "$root" ccache)"

    if elapsed=$(build_elapsed "$s"); then
      row "  building:" "$elapsed"
    fi
  done
}

##
#  Copied from https://git.archlinux.org/devtools.git/tree/lib/archroot.sh
##

##
#  Returns if the $path is a the root of a btrfs subvolume (including
#           the top-level subvolume).
#
#  usage  : is_subvolume( $path )
#  return : true if it is, false if not
##
is_subvolume() {
  [[ -e "$1" && "$(stat -f -c %T "$1")" == btrfs && "$(stat -c %i "$1")" == 256 ]]
}

##
#  Find all btrfs subvolumes under and including $path and delete them.
#
#  usage  : subvolume_delete_recursive( $path )
#  return : 0 if it was successful, 1 if not.
##
subvolume_delete_recursive() {
  local subvol
  is_subvolume "$1" || return 0
  while IFS= read -d $'\0' -r subvol; do
    if ! subvolume_delete_recursive "$subvol"; then
      return 1
    fi
  done < <(find "$1" -mindepth 1 -xdev -depth -inum 256 -print0)
  if ! btrfs subvolume delete "$1" &>/dev/null; then
    error "Unable to delete subvolume $1"
    return 1
  fi
  return 0
}

# delete the contents of a dir, removing any btrfs subvolumes first
wipe_dir() {
  local i
  for i in "${1:?}"/*; do
    [[ -e "$i" || -L "$i" ]] || continue
    if [[ -d "$i" ]]; then
      subvolume_delete_recursive "$i" || exit 1
    fi
    rm -rf "$i"
  done
}

purgecache() {
  [[ -n "$CCACHE_DIR" ]] || die "CCACHE_DIR is not defined in $CFGFILE"
  msg "Purging ccache..."
  wipe_dir "$CCACHE_DIR"
}

distcc_check() {
  # this is a catch-all function to check for a running distcc and to
  # override the THREADS value due to https://bugs.archlinux.org/task/64349
  # which to is not fixed even though it is closed

  # if the chroot is already created, see if distcc is enabled and
  # simply set RUNDISTCC which may or may not be set in the config file
  # if the user created the chroot with the 'cd' switch
  if buildenv_enabled "$CHROOTPATH/root" distcc; then
    RUNDISTCC=y
  fi

  # RUNDISTCC can also be forced via the 'cd' switch as well as set in the config
  if [[ -n "$RUNDISTCC" ]]; then
    [[ -n "$DISTCC_THREADS" ]] ||
      die "Define DISTCC_THREADS in $CFGFILE to build with distcc."
    # need to prefix the call to makechrootpkg with threads value
    # https://bugs.archlinux.org/task/64349
    THREADS=$DISTCC_THREADS
  fi
}

usage() {
  if [[ -r "$CFGFILE" ]]; then
    . "$CFGFILE"
  fi

  echo -e "${BOLD}$PKG v$VERS${ALL_OFF}"
  echo
  echo -e "${BOLD} Usage: ${RED}$0${ALL_OFF}${BOLD} ${ALL_OFF}${BLUE}[option]${ALL_OFF}"
  echo
  echo -e "${BOLD} --- SETUP AND BREAKDOWN  ---"
  echo -e "${BOLD}   c) Create the chroot${ALL_OFF}"
  echo -e "${BOLD}  cd) Create the chroot with distcc${ALL_OFF}"
  echo -e "${BOLD} <n>) Switch the active build slot to slot n${ALL_OFF}"
  echo -e "${BOLD}   n) Nuke the active chroot slot${ALL_OFF}"
  echo -e "${BOLD}   N) Nuke the chroot and external repo (if defined)${ALL_OFF}"
  echo -e "${BOLD}   t) Toggle [*-testing] on/off${ALL_OFF}"
  echo
  if [[ -n "$CCACHE_DIR" ]]; then
    echo -e "${BOLD} Target: ${BLUE}$CCACHE_DIR${ALL_OFF}"
    echo -e "${BOLD}  pc) Purge the ccache${ALL_OFF}"
    echo
  fi
  echo -e "${BOLD} --- BUILDING ---${ALL_OFF}"
  echo -e "${BOLD}   C) Re-run check() on a built package (passes '-ef' to default)${ALL_OFF}"
  echo -e "${BOLD}   R) Repackage (passes '-Rf' to default)${ALL_OFF}"
  echo -e "${BOLD}   S) Run makepkg but do not clean first${ALL_OFF}"
  echo -e "${BOLD}   s) Run makepkg (default)${ALL_OFF}"
  echo -e "${BOLD}      Optionally append package(s) to install into the chroot before building${ALL_OFF}"
  echo -e "${BOLD}      e.g. ccm s /path/foo.pkg.tar.zst /path/bar.pkg.tar.zst${ALL_OFF}"
  echo
  echo -e "${BOLD} --- LOCAL REPO ---${ALL_OFF}"
  echo -e "${BOLD}   a) Add packages in current dir to the local repo${ALL_OFF}"
  echo -e "${BOLD}   d) Delete selected packages in the local repo${ALL_OFF}"
  echo -e "${BOLD}   l) List packages in local repo${ALL_OFF}"
  echo
  echo -e "${BOLD} --- MISCELLANEOUS ---"
  echo -e "${BOLD}   p) Preview settings${ALL_OFF}"
  echo -e "${BOLD}   u) Update clean chroot${ALL_OFF}"
  if [[ -n "${MAX_ROOTS+x}" ]]; then
    echo
    echo -e "${BOLD} --- MULTI-ROOT (MAX_ROOTS=$MAX_ROOTS) ---${ALL_OFF}"
    echo -e "${BOLD}   c) Create next available slot${ALL_OFF}"
    echo -e "${BOLD}   <n>) Switch to slot n  (e.g. ccm 1, ccm 2)${ALL_OFF}"
  fi
}

# Functions are called as plain statements, never on the left of && or ||,
# so that set -e stays in effect inside them.
case "$1" in
  a)
    check_config
    check_gpgkey
    msg2 "Attempting to add all *pkg.tar* files to local repo"
    mapfile -t pkgs < <(find_pkgs "$PWD")
    sign_pkgs "${pkgs[@]}"
    indexit "${pkgs[@]}"
    ;;
  c|cd)
    check_config
    slot=$(next_free_slot) || {
      if [[ -n "$MULTI_ROOT" ]]; then
        die "All $MAX_ROOTS slots are in use. Nuke one before creating a new one."
      fi
      die "Working directory $CHROOTPATH already exists."
    }
    use_slot "$slot"
    acquire_build_lock
    # 'cd' forces running with distcc to override the config file setting
    if [[ "$1" == cd ]]; then
      RUNDISTCC=y
    fi
    distcc_check
    create
    # Auto-switch active slot to the one just created
    set_active_slot "$slot"
    if (( slot > 1 )); then
      msg "Slot $slot created at $CHROOTPATH. Now using slot $slot."
    fi
    ;;
  s|S|C|R)
    check_config
    check_gpgkey
    acquire_build_lock
    distcc_check
    case "$1" in
      s|S)
        if ! chroot_exists; then
          msg2 "No chroot has been created so making one now..."
          create
        fi
        msg2 "Attempting to build package..."
        INJECT_PKGS=("${@:2}")
        # only 's' starts from a clean copy of the chroot
        if [[ "$1" == s ]]; then
          CLEANIT=1
        fi
        ;;
      C)
        chroot_exists || die "No chroot has been created/nothing to check."
        msg2 "Attempting to re-run check()..."
        # reuse the existing src/ tree so only check() needs to be re-run
        MAKEPKG_ARGS=('-ef')
        RUNCHECK=1
        ;;
      R)
        chroot_exists || die "No chroot has been created/nothing to repackage."
        msg2 "Attempting to repackage..."
        MAKEPKG_ARGS=('-Rf')
        ;;
    esac
    build
    sign_pkgs "${BUILT_PKGS[@]}"
    indexit "${BUILT_PKGS[@]}"
    msg2 "Total build time was $BUILD_TIME"
    if [[ "$1" == [sS] ]]; then
      logbuild "${BUILT_PKGS[0]}"
    fi
    ;;
  pc)
    check_config
    purgecache
    ;;
  t)
    check_config
    acquire_build_lock
    check_chroot
    # no need to call update since testing function handles this
    testing
    ;;
  d)
    check_config
    repocheck
    msg "Use space-separated numbers to select packages to delete, 'a' for all packages, and 'q' to quit."
    echo
    deletepkgs
    ;;
  l)
    check_config
    repocheck
    msg "Listing out packages in chroot repo..."
    list
    ;;
  n)
    check_config
    acquire_build_lock
    msg "Deleting the entire chroot..."
    nuke
    ;;
  N)
    check_config
    acquire_build_lock
    msg "Deleting the entire chroot and external repo..."
    nuke
    nukeallpkgs
    ;;
  p)
    check_config
    preview
    ;;
  u)
    check_config
    acquire_build_lock
    check_chroot
    update
    ;;
  [0-9]*)
    check_config
    [[ -n "$MULTI_ROOT" ]] ||
      die "Multi-root not enabled. Set MAX_ROOTS in your config to use this feature."
    target_slot="$1"
    if ! [[ "$target_slot" =~ ^[0-9]+$ ]] || [[ "$target_slot" -lt 1 ]]; then
      die "Invalid slot number: $target_slot"
    fi
    if [[ "$target_slot" -gt "$MAX_ROOTS" ]]; then
      die "Slot $target_slot exceeds MAX_ROOTS ceiling of $MAX_ROOTS."
    fi
    slot_exists "$target_slot" ||
      die "Slot $target_slot does not exist. Run 'ccm c' to create it."
    set_active_slot "$target_slot"
    msg "Switched to slot $target_slot ($(slot_path "$target_slot"))."
    ;;
  *)
    usage
    ;;
esac

# vim:set ts=2 sw=2 et:
